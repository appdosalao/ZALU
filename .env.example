# Supabase
# Obtenha em: supabase.com → Project Settings → API
# NOTA: NÃO existe valor padrão no código. Sem estas variáveis o build falha de propósito
# (evita chaves hardcoded no bundle). Copie este arquivo para .env em dev local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Vercel Serverless) — NUNCA exponha a service_role no frontend
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend (Vite)
VITE_CAKTO_CHECKOUT_MENSAL_URL=https://pay.cakto.com.br/3banwdk_876948
VITE_CAKTO_CHECKOUT_VITALICIO_URL=https://pay.cakto.com.br/yxf3vku_817713

# Backend (Vercel Serverless)
CAKTO_API_KEY=
CAKTO_WEBHOOK_SECRET=
CAKTO_PRODUCT_URL=https://pay.cakto.com.br/3banwdk_876948
FRONTEND_URL=https://zalusalao.online/
